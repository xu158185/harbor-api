# ============================================================================
# HarborAPI Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the required values
# Run ./scripts/generate-secrets.sh to auto-generate secure secrets

# ---------- 域名与端口 ----------
DOMAIN=localhost
# 绑定地址，生产环境改为 127.0.0.1（只接受来自 Caddy 的请求）
BIND_HOST=0.0.0.0

# ---------- 数据库凭据（必须设置）----------
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ---------- 应用密钥（必须设置）----------
# sub2api JWT 密钥，至少 32 字符
JWT_SECRET=
# sub2api TOTP 加密密钥，必须 32 字符
TOTP_ENCRYPTION_KEY=
# new-api session 密钥，建议 64 字符
SESSION_SECRET=

# ---------- 管理员账号（首次设置）----------
ADMIN_EMAIL=admin@harbor.local
# 留空时 sub2api 会在首次启动时要求设置，new-api 会生成默认 token
ADMIN_PASSWORD=

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 可选：GitHub Token ----------
# 用于更新检测，避免 API rate limit。不设置也能用，但频繁检查更新可能被限流
# 生成地址：https://github.com/settings/tokens （只需 public_repo 权限）
UPDATE_GITHUB_TOKEN=

# ---------- 可选：代理 ----------
# 更新时拉取 GitHub release 的代理（国内网络可能需要）
UPDATE_PROXY_URL=
